{
    "name": "@openhandle/sdk",
    "version": "1.0.0",
    "description": "Official TypeScript SDK for OpenHandle",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openhandlehq/openhandle-typescript.git"
    },
    "homepage": "https://github.com/openhandlehq/openhandle-typescript#readme",
    "bugs": {
        "url": "https://github.com/openhandlehq/openhandle-typescript/issues"
    },
    "keywords": [
        "openhandle",
        "social-media",
        "api",
        "sdk",
        "typescript"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "generate": "node scripts/generate.mjs",
        "generate:check": "node scripts/generate.mjs --check",
        "build": "pnpm generate && tsc -p tsconfig.build.json",
        "eval:agent": "node scripts/score-agent-eval.mjs evals/reference",
        "test": "pnpm build && tsc --noEmit -p tsconfig.test.json && pnpm eval:agent && node --test tests/*.test.ts",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "typecheck": "pnpm generate:check && tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@types/node": "^24.0.0",
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@11.20.0"
}
